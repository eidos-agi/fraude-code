#!/usr/bin/env bash
# flickercheck — catch screen flicker in a terminal recording (gif/mp4/webm).
#
# How: brightness of the DIFFERENCE between consecutive frames. A full-screen repaint
# (the flicker you see) shows up as a big isolated spike between calm frames; steady typing
# stays low. Prints a report and exits non-zero if flicker exceeds --max (default 5%).
#
# Usage: flickercheck <recording> [--max PCT] [--threshold N]
set -euo pipefail

file="${1:-}"
[ -z "$file" ] && { echo "usage: flickercheck <recording> [--max PCT] [--threshold N]"; exit 2; }
shift || true
max_pct=5      # fail if more than this % of frames are full-repaint-like
thr=4          # inter-frame diff (0-255) above which a frame counts as a "big jump"
while [ $# -gt 0 ]; do
  case "$1" in
    --max) max_pct="$2"; shift 2;;
    --threshold) thr="$2"; shift 2;;
    *) echo "unknown arg: $1"; exit 2;;
  esac
done

command -v ffmpeg >/dev/null || { echo "flickercheck needs ffmpeg"; exit 3; }

tmp="$(mktemp)"
ffmpeg -i "$file" -vf \
  "format=gray,tblend=all_mode=difference,signalstats,metadata=print:key=lavfi.signalstats.YAVG:file=$tmp" \
  -f null - >/dev/null 2>&1

awk -F= -v thr="$thr" -v maxp="$max_pct" '
  /YAVG/ { v=$2; n++; s+=v; if(v>mx)mx=v; a[n]=v; if(v>thr)big++ }
  END {
    if (n==0) { print "no frames analyzed"; exit 3 }
    osc=0; for(i=2;i<n;i++) if(a[i]>thr && a[i-1]<thr/2 && a[i+1]<thr/2) osc++
    pct=100*big/n
    printf "frames:            %d\n", n
    printf "mean frame diff:   %.2f\n", s/n
    printf "max frame diff:    %.2f\n", mx
    printf "big jumps (>%d):    %d  (%.0f%% of frames)\n", thr, big, pct
    printf "flicker spikes:    %d  (isolated big frame between calm frames)\n", osc
    if (pct > maxp) { printf "VERDICT: FLICKER (%.0f%% > %d%% budget)\n", pct, maxp; exit 1 }
    printf "VERDICT: clean (%.0f%% <= %d%% budget)\n", pct, maxp
  }
' "$tmp"
rc=$?
rm -f "$tmp"
exit $rc
